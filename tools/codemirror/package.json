{
  "name": "funground-editor-bundle",
  "private": true,
  "type": "module",
  "description": "Builds site_src/play/vendor/codemirror.js, the code editor of the Play page. Run: npm install, then npm run build.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=esm --legal-comments=none --outfile=../../site_src/play/vendor/codemirror.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0"
  }
}
